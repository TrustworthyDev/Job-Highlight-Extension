{
  "manifest_version": 3,
  "name": "Hide & Highlight — Job Tools",
  "version": "1.2.0",
  "description": "Hide cards and highlight keywords on any site, plus tint \"Viewed\" listings on LinkedIn.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Hide Viewed Jobs",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "hidden.html",
    "open_in_tab": true
  },
  "permissions": ["storage", "nativeMessaging", "alarms"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
